{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// 로컬 미리보기: wrangler dev  -> http://localhost:8787/
	// Cloudflare Workers Builds(Git 연동)가 브랜치/PR 푸시마다 `wrangler preview`로 프리뷰 빌드를 만든다.
	// name은 대시보드에 연결된 Worker 이름(tsukuyomi)과 같아야 빌드가 통과한다.
	"name": "tsukuyomi",
	"compatibility_date": "2026-08-01",
	"main": "preview-worker.js",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// "/" 요청도 Worker를 먼저 거쳐 tsukuyomi.html로 매핑하기 위해 필요
		"run_worker_first": true
	},
	"dev": {
		"port": 8787
	},
	// `wrangler preview`(Workers Builds 프리뷰 명령)는 이 블록이 있어야 동작한다. 비어 있어도 됨.
	"previews": {},
	// production workers.dev 노출은 끔
	"workers_dev": false
}
